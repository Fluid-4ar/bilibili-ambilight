{
  "manifest_version": 3,
  "name": "Bilibili Ambilight - Custom",
  "description": "Bilibili 環境光的個人修改版，支援寬螢幕標題與 UP 主資訊淡入顯示。（基於 iceorange-dev 的開源專案）",
  "version": "0.0.0",
  "homepage_url": "https://github.com/IvarLiu/bilibili-ambilight",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "128": "images/icon-128.png"
  },
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0",
      "id": "{ccb7eb4d-b77c-4cfe-aada-5bcb9eef2ace}"
    }
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "24": "images/icon-24.png",
      "32": "images/icon-32.png"
    },
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/medialist/play/*",
        "https://www.bilibili.com/festival/*",
        "https://www.bilibili.com/cheese/play/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/content.css",
        "scripts/content-main.js",
        "scripts/injected.js",
        "images/noise-1.png",
        "images/noise-2.png",
        "images/noise-3.png"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage"
  ]
}
